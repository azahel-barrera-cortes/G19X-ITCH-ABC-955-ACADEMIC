# ===========================================================================
#  GICORP / PluriActas - Variables de entorno del Backend
#  Copia este archivo como `.env`  ->  copy .env.example .env
# ===========================================================================

# --- Aplicación ------------------------------------------------------------
APP_NAME="GICORP / PluriActas"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Orígenes permitidos por CORS (separados por coma). Incluye el puerto de Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos ---------------------------------------------------------
# PRODUCCIÓN / Docker (PostgreSQL 16). Requiere: pip install -r requirements-postgres.txt
DATABASE_URL=postgresql+psycopg://pluriactas:pluriactas@localhost:5432/pluriactas
# DESARROLLO sin servidor de base de datos (por defecto, funciona sin instalar nada)
# DATABASE_URL=sqlite:///./pluriactas.db
AUTO_CREATE_TABLES=true
SQL_ECHO=false

# --- Maquetado del acta (ReportLab) ---------------------------------------
MARGEN_CM=2.5
INCLUIR_NUMERACION_PAGINAS=true
PIE_CONFIDENCIALIDAD="Documento confidencial generado electrónicamente por GICORP / PluriActas. Su contenido es informativo y no sustituye la revisión de un abogado corporativo."

# --- Inteligencia Artificial ----------------------------------------------
# Proveedor de redacción. Valores: auto | azure_openai | gemini |
#                              openai_compatible | plantillas
#   auto               -> Azure OpenAI, luego Gemini, luego openai_compatible;
#                         si no hay ninguna credencial, degrada a `plantillas`.
#   openai_compatible  -> cualquier API compatible con OpenAI (OpenAI, Ollama,
#                         Groq, DeepSeek, LM Studio, vLLM). Permite usar un LLM
#                         100 % local para no enviar el acta a terceros.
#   plantillas         -> redacción determinista sin servicios externos (offline).
AI_PROVIDER=auto
AI_ALLOW_FALLBACK=true
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1500
# Robustez y rendimiento
AI_MAX_REINTENTOS=3            # reintentos por proveedor ante errores transitorios
AI_MAX_CONCURRENCY=4           # acuerdos redactados en paralelo
AI_STREAM=true                 # expone el endpoint SSE de redacción en vivo
AI_JSON_MODE=true              # fuerza respuesta JSON estructurada
AI_VERIFICAR_FIDELIDAD=true    # advierte cuando el texto inventa cifras
AI_MAX_CLAUSULAS_POR_LLAMADA=3 # >1 agrupa acuerdos en una sola petición

# --- Azure OpenAI ----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Endpoint compatible con OpenAI ----------------------------------------
# Opción A) OpenAI (nube)
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o
#   AI_API_KEY=sk-...
# Opción B) Ollama 100 % local (gratis, sin enviar datos fuera de tu equipo)
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.1:8b
#   AI_API_KEY=            # se puede dejar vacío
# Opción C) LM Studio / vLLM
#   AI_BASE_URL=http://localhost:1234/v1
#   AI_MODEL=local-model
#   AI_API_KEY=not-needed
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
