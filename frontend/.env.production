# ===========================================================================
#  PGAC - Variables de entorno del Frontend (producción)
# ===========================================================================

# En producción el frontend se sirve estáticamente detrás del mismo dominio
# que el backend (proxy inverso), por lo que la API está en la misma origen.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=PGAC
VITE_APP_VERSION=0.1.0