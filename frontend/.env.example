# ===========================================================================
#  GICORP / PluriActas - Variables de entorno del Frontend
#  Copia este archivo como `.env` si necesitas ajustar los valores.
# ===========================================================================

# Ruta base de la API consumida por axios. Con el proxy de Vite (npm run dev)
# basta con dejar `/api/v1`; en producción usa la URL completa del backend.
VITE_API_BASE_URL=/api/v1

# Destino del proxy de desarrollo de Vite (backend de FastAPI).
VITE_API_PROXY=http://127.0.0.1:8000
